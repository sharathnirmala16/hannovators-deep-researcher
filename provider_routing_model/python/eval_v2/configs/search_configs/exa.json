{
  "schemaVersion": "search-collection-config/v1",
  "provider": "exa",
  "limit": 5,
  "options": {
    "type": "auto",
    "contents": {
      "highlights": true
    }
  },
  "rateLimits": [
    {
      "requests": 1,
      "windowMs": 1000
    }
  ],
  "maxConcurrency": 4,
  "limits": {
    "requestTimeoutMs": 30000,
    "queryTimeoutMs": 65000,
    "maxRequestsPerQuery": 2,
    "maxRetries": 1
  }
}
