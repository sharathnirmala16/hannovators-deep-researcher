{
  "schemaVersion": "search-collection-config/v1",
  "provider": "keenable",
  "limit": 5,
  "options": {
    "mode": "pro"
  },
  "rateLimits": [
    {
      "requests": 1,
      "windowMs": 4000
    },
    {
      "requests": 950,
      "windowMs": 3600000
    }
  ],
  "maxConcurrency": 2,
  "limits": {
    "requestTimeoutMs": 30000,
    "queryTimeoutMs": 65000,
    "maxRequestsPerQuery": 2,
    "maxRetries": 1
  }
}
