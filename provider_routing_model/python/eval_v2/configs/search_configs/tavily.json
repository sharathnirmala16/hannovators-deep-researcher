{
  "schemaVersion": "search-collection-config/v1",
  "provider": "tavily",
  "limit": 5,
  "options": {
    "search_depth": "basic",
    "include_raw_content": false
  },
  "rateLimits": [
    {
      "requests": 1,
      "windowMs": 1000
    }
  ],
  "maxConcurrency": 4,
  "limits": {
    "requestTimeoutMs": 30000,
    "queryTimeoutMs": 65000,
    "maxRequestsPerQuery": 2,
    "maxRetries": 1
  }
}
