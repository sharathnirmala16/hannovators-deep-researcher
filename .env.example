# Copy this file to .env and fill in the values. Never commit .env.
# scripts/windows/create_worktree.bat copies the main .env into each worktree
# and replaces API_PORT and VITE_PORT with the slot ports.

# --- Transport -----------------------------------------------------------------
# Each worktree uses its own ports (see the port table in AGENTS.md).
# No port has a default: a missing port stops the API or the dev server.
# Main repository: API_PORT=8001, VITE_PORT=5174
API_HOST=127.0.0.1
# API_PORT=
# VITE_PORT=

# --- Runtime mode --------------------------------------------------------------
# real = live providers; fake = deterministic offline fakes for every port.
PROVIDER_MODE=real

# --- Database ------------------------------------------------------------------
# Optional override. Relative SQLite paths resolve from the project root, so each
# worktree gets its own database. Worktree setup removes this line from copies.
# DATABASE_URL=sqlite+aiosqlite:///data/hannovators.db

# --- Nebius Token Factory (agent model + embeddings) ---------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
AGENT_MODEL=nvidia/Nemotron-3.5-Super-VL
# Optional per-role overrides: DECOMPOSE, QUERY, APPRAISE, EXTRACT_VISION, SYNTHESIZE
# MODEL_APPRAISE=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Matryoshka size, 32 to 4096. Changing it needs new workspaces.
EMBEDDING_DIMENSIONS=1024

# --- Jev System One via Command Code -------------------------------------------
# Command Code API key with Provider API access (GOAT plan or above).
JEV_API_KEY=
JEV_BASE_URL=https://api.commandcode.ai/provider/v1
JEV_MODEL=typesafe/jev-1.14.0
JEV_CONCURRENCY=8
JEV_MAX_STATE_TOKENS=24000

# --- Web search ----------------------------------------------------------------
# auto = first configured provider in WEB_SEARCH_PRIORITY, with failover.
# Set one provider name to pin it.
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_PRIORITY=tavily,exa
TAVILY_API_KEY=
EXA_API_KEY=

# --- PubMed (NCBI E-utilities) -------------------------------------------------
# Optional key raises the limit from 3 to 10 requests per second.
NCBI_API_KEY=
NCBI_EMAIL=

# --- Run budget ----------------------------------------------------------------
RUN_BUDGET_MAX_CANDIDATES=100
